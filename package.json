{
  "name": "system-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n API,WEB -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "SYSTEM_PRO_DEV_CREDENTIALS=true tsx watch server/index.ts",
    "dev:web": "wait-on tcp:3001 && vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "preview": "npm run build && NODE_ENV=production node build/server/index.js",
    "create-admin": "tsx scripts/create-admin.ts",
    "test": "tsx --test server/auth/password.test.ts server/db/auth-repository.test.ts server/auth/auth-api.test.ts server/auth/dev-demo-user.test.ts server/auth/trusted-origins.test.ts",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "radix-ui": "^1.8.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.0",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "wait-on": "^9.5.1"
  }
}
